{
  "name": "deslop",
  "version": "0.1.0",
  "description": "Review and fix committed work, run checks, and mark the final commit",
  "type": "module",
  "bin": {
    "deslop": "bin/deslop.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test",
    "deslop": "node src/cli.ts run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "jiti": "2.7.0",
    "picomatch": "4.0.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "docs",
    "LICENSE",
    "eslint",
    "skills"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "22.20.5"
  }
}
